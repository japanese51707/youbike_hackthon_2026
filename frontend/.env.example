# 前端連線設定範本。複製成 frontend/.env 使用。
#
# 前端透過 Vite dev proxy 連後端：VITE_API_BASE_URL=/api/v1（相對路徑）→ proxy 轉到 YOUBIKE_BACKEND_URL。
# 這樣使用者從 GitHub 拉下來只要 npm install && npm run dev 就能連到「雲端後端」，
# 天氣/資料/預測金鑰都在雲端後端，使用者不需要自己準備任何金鑰。

# API 模式（api=接後端；mock=本機隔離示範）
VITE_DATA_MODE=api

# 前端呼叫路徑（相對，走 Vite proxy；正式反向代理也用這個）
VITE_API_BASE_URL=/api/v1

# 後端位址（Vite dev proxy 目標）：
#   雲端後端（ADR-307 ECS Fargate，us-east-1）— 使用者用這個就能直接跑起來，
#   天氣/資料/預測/Bedrock 顧問（ADR-311）都在雲端後端走 IAM task role，使用者免任何金鑰：
YOUBIKE_BACKEND_URL=http://107.22.14.3:8000
#   若要連本機後端，改成： http://127.0.0.1:8000
#   注意：ECS 重新部署後 public IP 會變動，屆時更新此位址（賽後資源會關閉）。
