<mxfile host="app.diagrams.net" version="24.0.0">
  <diagram id="frontend-api-contract" name="前端資料契約">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="2100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="YouBike 智慧調度系統 — 前端資料契約（P0/P1/P2 端點皆已接真實）" style="text;html=1;fontSize=20;fontStyle=1;align=center;fontColor=#0d47a1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="2520" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="端點前綴 /api/v1 ｜ X-Operator-Id 標頭辨識身分 ｜ 資源走工廠 get_xxx() 可抽換 ｜ 詳細欄位見 api_reference_for_frontend.md" style="text;html=1;fontSize=13;align=center;fontColor=#455a64;" vertex="1" parent="1">
          <mxGeometry x="40" y="58" width="2520" height="24" as="geometry" />
        </mxCell>

        <!-- 圖例 -->
        <mxCell id="legend_box" value="圖例（接線狀態）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#90a4ae;fontColor=#263238;fontStyle=1;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="92" width="700" height="76" as="geometry" />
        </mxCell>
        <mxCell id="legend_real" value="■ 已接真實系統（可直接串）— 現在絕大多數端點都是這個" style="text;html=1;fontSize=12;align=left;fontColor=#1b5e20;" vertex="1" parent="1">
          <mxGeometry x="55" y="118" width="420" height="20" as="geometry" />
