          <mxGeometry x="55" y="142" width="420" height="20" as="geometry" />
        </mxCell>
        <mxCell id="legend_note" value="資料分層：即時（站況/天氣/預測）前端輪詢；靜態（位置/地形/POI/指紋）開場拉一次" style="text;html=1;fontSize=12;align=left;fontColor=#616161;" vertex="1" parent="1">
          <mxGeometry x="380" y="118" width="350" height="44" as="geometry" />
        </mxCell>

        <!-- 欄位標頭 -->
        <mxCell id="col1" value="前端呈現（畫面）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0d47a1;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="40" y="184" width="520" height="36" as="geometry" />
        </mxCell>
        <mxCell id="col2" value="API 端點（/api/v1）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0d47a1;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="640" y="184" width="1000" height="36" as="geometry" />
        </mxCell>
        <mxCell id="col3" value="後端系統 / 資料來源（可抽換工廠）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0d47a1;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="1720" y="184" width="840" height="36" as="geometry" />
        </mxCell>

        <!-- 列1 地圖 -->
        <mxCell id="ui_map" value="即時站點地圖（1600 站）&#10;空/滿/正常/故障 色階、行政區篩選" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;fontColor=#0d47a1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="234" width="520" height="70" as="geometry" />
        </mxCell>
        <mxCell id="api_map" value="GET /stations　［🟢］→ 1600 站陣列&#10;station_id/name/district/lat,lng/total_docks/&#10;available_bikes/available_docks/usage_rate/&#10;status(empty/full/low/high/normal/offline)/data_freshness&#10;GET /stations?status=offline → 故障/未啟用站（可借+可還=0）" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=8;fillColor=#e8f5e9;strokeColor=#2e7d32;fontColor=#1b5e20;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="640" y="228" width="1000" height="82" as="geometry" />
        </mxCell>
        <mxCell id="be_ds" value="get_data_source() 資料源（ADR-006 可抽換）&#10;youbike_official(新北即時) / historical(S3) / tdx / mock&#10;+ 降級保護 + 故障站偵測(ADR-108)" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=8;fillColor=#e8f5e9;strokeColor=#2e7d32;fontColor=#1b5e20;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1720" y="234" width="840" height="70" as="geometry" />
        </mxCell>

        <!-- 列2 單站詳情+靜態 -->
        <mxCell id="ui_detail" value="單站詳情面板&#10;即時：歷史曲線+預測區間&#10;靜態：地形/POI/行為指紋（開場拉一次）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;fontColor=#0d47a1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="326" width="520" height="80" as="geometry" />
        </mxCell>
        <mxCell id="api_detail" value="GET /stations/{id}　［🟢］→ current/history/prediction(4視野P10/P50/P90)/params&#10;GET /stations/{id}/static　［🟢］→ location + terrain(海拔/坡度) +&#10;　poi(area_type+14類距離) + profile(行為指紋/站型)　★靜態,開場拉一次&#10;GET /stations/{id}/params｜/params/history｜/params/rollback　［🟢 DB三層］" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=8;fillColor=#e8f5e9;strokeColor=#2e7d32;fontColor=#1b5e20;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="640" y="322" width="1000" height="88" as="geometry" />
        </mxCell>
        <mxCell id="be_model" value="模型+特徵(ADR-101~113)★已完成&#10;LightGBMPredictor.predict_multi(4視野區間)&#10;terrain快取/poi現算/profile離線快取(_profile_cache)&#10;CWA即時天氣(觀測站級)" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=8;fillColor=#e8f5e9;strokeColor=#2e7d32;fontColor=#1b5e20;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1720" y="322" width="840" height="88" as="geometry" />
        </mxCell>

        <!-- 列3 調度建議 -->
        <mxCell id="ui_reco" value="需調度清單（緊急度排序）&#10;後台組單起點畫面（故障站已排除）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;fontColor=#0d47a1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="428" width="520" height="70" as="geometry" />
        </mxCell>
        <mxCell id="api_reco" value="GET /dispatch/recommendations　［🟢 規則引擎］→ list(已排序)：&#10;station_id/name/district/action(補車/取車)/quantity/target_available(目標存量)/&#10;urgency_tier(censored/warning/normal)/priority_score(0~100)/priority_level/&#10;breach_horizon_min/arrival_by_horizon{30,60,90,120}/reason/basis/override_active" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=8;fillColor=#e8f5e9;strokeColor=#2e7d32;fontColor=#1b5e20;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="640" y="422" width="1000" height="82" as="geometry" />
        </mxCell>
        <mxCell id="be_rule" value="規則引擎+緊急度+目標水位(ADR-111/112/115)★已完成&#10;三層判斷→緊急度分數→動態目標水位&#10;dispatcher.build_dispatch_list(排序+資源限制)" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=8;fillColor=#e8f5e9;strokeColor=#2e7d32;fontColor=#1b5e20;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1720" y="428" width="840" height="70" as="geometry" />
        </mxCell>

        <!-- 列4 互動組單 -->
        <mxCell id="ui_build" value="後台派工組單台&#10;三入口按鈕 + 草稿預覽卡（含預估）&#10;+ 確認派發" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;fontColor=#0d47a1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="520" width="520" height="96" as="geometry" />
        </mxCell>
        <mxCell id="api_build" value="互動組單三入口（ADR-119）［🟢］→ 皆回草稿 draft(is_draft+estimate)&#10;POST /dispatch/build/from-vehicle　(以車:vehicle_id/operator_id/district?)&#10;POST /dispatch/build/from-station　(以站:station_id → +vehicle_candidates 三類車)&#10;POST /dispatch/build/emergency　(緊急:station_ids[] → +resource_suggestion)&#10;POST /dispatch/confirm-trip　(確認落地,需dispatcher權限,body:draft)&#10;estimate: est_distance_km/est_travel_min/est_work_min/total_quantity/urgency_sum" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=8;fillColor=#e8f5e9;strokeColor=#2e7d32;fontColor=#1b5e20;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="640" y="516" width="1000" height="104" as="geometry" />
        </mxCell>
        <mxCell id="be_build" value="dispatch_builder + 底層(ADR-114/116/117/119)★已完成&#10;三入口組單(先取後放/載運量切趟/最近測站)&#10;fleet/operator provider(可抽換)/班別工時(shift)&#10;確認→_persist_trip落地+認領標註" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=8;fillColor=#e8f5e9;strokeColor=#2e7d32;fontColor=#1b5e20;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1720" y="520" width="840" height="96" as="geometry" />
        </mxCell>

        <!-- 列5 任務執行 -->
        <mxCell id="ui_exec" value="任務執行看板&#10;派工單+認領地圖+逐站進度&#10;+後台介入+下一趟建議" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;fontColor=#0d47a1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="632" width="520" height="96" as="geometry" />
        </mxCell>
        <mxCell id="api_exec" value="任務執行閉環（ADR-117/119）［🟢］&#10;GET /dispatch/tasks｜/tasks/{id}　(任務清單/詳情,含站級route)&#10;POST /dispatch/tasks/{id}/report　(逐站回報:station_id/actual_available)&#10;DELETE /tasks/{id}/stations/{sid}　(後台抽離,需dispatcher)&#10;POST /tasks/{id}/stations　(後台增站) ｜ POST /tasks/{id}/return　(執行者退回附原因)&#10;GET /dispatch/claim-map　(認領地圖) ｜ GET /dispatch/next-trip?vehicle_id=　(下一趟建議)" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=8;fillColor=#e8f5e9;strokeColor=#2e7d32;fontColor=#1b5e20;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="640" y="628" width="1000" height="104" as="geometry" />
        </mxCell>
        <mxCell id="be_exec" value="task_execution + task_manager(ADR-117)★已完成&#10;逐站回報(記目標vs實際落差)/認領地圖/&#10;後台抽離增站/執行者退回/狀態機" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=8;fillColor=#e8f5e9;strokeColor=#2e7d32;fontColor=#1b5e20;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1720" y="632" width="840" height="96" as="geometry" />
        </mxCell>

        <!-- 列6 警示+死結 -->
        <mxCell id="ui_alert" value="即時警示面板 / 紅字告警&#10;含死結救火、SSE 即時推播" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;fontColor=#0d47a1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="744" width="520" height="80" as="geometry" />
        </mxCell>
        <mxCell id="api_alert" value="警示+死結救火（ADR-118）［🟢］&#10;GET /alerts　(alert_id/level(info/warning/critical)/station/message/suggested_action/acknowledged)&#10;POST /alerts/{id}/acknowledge ｜ GET /alerts/stream(SSE) ｜ POST /alerts/subscribe&#10;GET /emergency/deadlocks　(各區死結大站) ｜ POST /emergency/check　(死結救火→派standby)" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=8;fillColor=#e8f5e9;strokeColor=#2e7d32;fontColor=#1b5e20;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="640" y="740" width="1000" height="90" as="geometry" />
        </mxCell>
        <mxCell id="be_alert" value="alert_service + emergency(ADR-118)★已完成&#10;分級/推播/SSE/webhook(出向SSRF)&#10;死結偵測→派預備車救火(可跨區)" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=8;fillColor=#e8f5e9;strokeColor=#2e7d32;fontColor=#1b5e20;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1720" y="744" width="840" height="80" as="geometry" />
        </mxCell>

        <!-- 列7 人力車隊 -->
        <mxCell id="ui_fleet" value="人力/車隊狀態面板&#10;調度員(四角色)·調度車·預備車·總站待命" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;fontColor=#0d47a1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="844" width="520" height="80" as="geometry" />
        </mxCell>
        <mxCell id="api_fleet" value="人力車隊（ADR-114/116/118）［🟢］&#10;GET /operators?role_type=　(driver/stationed/controller/depot_standby)/status/current_district&#10;GET /vehicles　(max_capacity/status/is_depot/current_district)&#10;GET /vehicles/standby　({reserve_standby, depot_standby})" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=8;fillColor=#e8f5e9;strokeColor=#2e7d32;fontColor=#1b5e20;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="640" y="840" width="1000" height="88" as="geometry" />
        </mxCell>
        <mxCell id="be_fleet" value="operators/vehicles repo + providers(ADR-114/116)★已完成&#10;四角色+動態current_district / 車隊主檔+standby保留率&#10;+is_depot總站待命 / 可抽換(未來接YouBike API)" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=8;fillColor=#e8f5e9;strokeColor=#2e7d32;fontColor=#1b5e20;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1720" y="844" width="840" height="88" as="geometry" />
        </mxCell>

        <!-- 列8 營運+天氣+最適化 -->
        <mxCell id="ui_ops" value="營運儀表板 / 後台操作&#10;KPI·天氣·緊急覆寫·每日最適化·稽核" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;fontColor=#0d47a1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="948" width="520" height="110" as="geometry" />
        </mxCell>
        <mxCell id="api_ops" value="GET /kpi　［🟢］(總站/in_service/offline/空/滿/健康率/平均借用率)&#10;GET /weather/by-location?lat=&amp;lng=　［🟢 CWA］(最近雨量站+氣象站)&#10;POST·DELETE /stations/{id}/emergency-override｜GET /overrides/active　［🟢 覆寫］&#10;GET /optimization/daily-review　［🟢 optimizer 分情境偏差建議,做法Y〕&#10;　+ /station/{id}·/approve·/reject (核准→存ai_optimized版本)&#10;GET /audit/logs　［🟢 稽核留痕〕" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=8;fillColor=#e8f5e9;strokeColor=#2e7d32;fontColor=#1b5e20;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="640" y="944" width="1000" height="118" as="geometry" />
        </mxCell>
        <mxCell id="be_ops" value="營運支援模組（ADR-118/120）★已完成&#10;kpi即時統計/weather_source(CWA可抽換)/override_service/audit&#10;param_optimizer(ADR-120做法Y:建議+核准存版本;生效接線待補)" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=8;fillColor=#e8f5e9;strokeColor=#2e7d32;fontColor=#1b5e20;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1720" y="948" width="840" height="110" as="geometry" />
        </mxCell>

        <!-- 少數 mock -->
        <mxCell id="mock_box" value="少數仍 mock（非 demo 主線，欄位已定值待接）：&#10;🔴 GET /stations/timeline（時間軸播放）　🔴 POST/DELETE /stations（新增/刪除站別）&#10;🔴 GET /simulation/replay（Before/After 模擬引擎，刻意排最後，概念見 docs/analysis/future_simulation_replay_concept.md）&#10;🔴 GET /operators/{id}/stream（SSE 位置推播）" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=10;fillColor=#ffebee;strokeColor=#b71c1c;fontColor=#b71c1c;fontSize=12;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="1082" width="2520" height="86" as="geometry" />
        </mxCell>

        <!-- 連線 前端→API -->
        <mxCell id="e1" style="endArrow=classic;html=1;strokeColor=#546e7a;" edge="1" parent="1" source="ui_map" target="api_map"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="endArrow=classic;html=1;strokeColor=#546e7a;" edge="1" parent="1" source="ui_detail" target="api_detail"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" style="endArrow=classic;html=1;strokeColor=#546e7a;" edge="1" parent="1" source="ui_reco" target="api_reco"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" style="endArrow=classic;html=1;strokeColor=#546e7a;" edge="1" parent="1" source="ui_build" target="api_build"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" style="endArrow=classic;html=1;strokeColor=#546e7a;" edge="1" parent="1" source="ui_exec" target="api_exec"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" style="endArrow=classic;html=1;strokeColor=#546e7a;" edge="1" parent="1" source="ui_alert" target="api_alert"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" style="endArrow=classic;html=1;strokeColor=#546e7a;" edge="1" parent="1" source="ui_fleet" target="api_fleet"><mxGeometry relative="1" as="geometry" /></mxCell>
