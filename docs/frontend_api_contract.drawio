        <!-- 連線 API→後端 -->
        <mxCell id="b1" style="endArrow=classic;html=1;strokeColor=#546e7a;dashed=1;" edge="1" parent="1" source="api_map" target="be_ds"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="b2" style="endArrow=classic;html=1;strokeColor=#546e7a;dashed=1;" edge="1" parent="1" source="api_detail" target="be_model"><mxGeometry relative="1" as="geometry" /></mxCell>
