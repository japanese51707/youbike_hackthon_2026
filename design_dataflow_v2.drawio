        <mxCell id="r1" value="任務回報（含位置）&#8594; 驗證 &#8594; dispatcher 重算下一站" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#C2410C;strokeWidth=2;fontSize=11;fontColor=#C2410C;dashed=1;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;exitX=0;exitY=0.5;entryX=0;entryY=1;" edge="1" parent="1" source="feop" target="taskmgr"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r2" value="③ 緊急覆寫（經 API）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#C2410C;strokeWidth=2;fontSize=11;fontColor=#C2410C;dashed=1;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="fedash" target="override"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="flows" value="&lt;b&gt;三條主要資料流&lt;/b&gt;&#8195;&lt;b&gt;路徑 1 監控 &#8594; 警示 &#8594; 調度&lt;/b&gt;：data_source &#8594; predictor（算預測到達存量）&#8594; urgency &#8594; alert_service 推警示／rule_engine 判斷 &#8594; dispatcher 排序 &#8594;【人工確認閘門】&#8594; task_manager 派發&lt;br&gt;&lt;b&gt;路徑 2 任務循環&lt;/b&gt;：調度員接任務 &#8594; 逐站回報（含位置）&#8594; task_manager 驗證 &#8594; dispatcher 依位置重算下一站 &#8594; 未執行的緊急任務可動態轉派&lt;br&gt;&lt;b&gt;路徑 3 每日最適化&lt;/b&gt;：param_optimizer 讀近 N 天（排除異常日）&#8594; 逐站微調（幅度上限）&#8594; versioning 存舊版 &#8594;【人工確認 approve/reject】&#8594; 套用為 ② 層參數&lt;br&gt;&lt;b&gt;觸發門檻是動態的&lt;/b&gt;：rule_engine 不用「可借車數 &#8804; 3」這類死數字；改由「當前存量 &#8722; 該站該時段歷史淨流出 = 預測到達時存量」比對 config.trigger.安全緩衝_台數（design.md &#167;7）&lt;br&gt;&lt;b&gt;出向資安&lt;/b&gt;：每一條離開系統邊界的箭頭都要問「我會不會被帶壞或洩漏」&#8212; 第三方回應當不可信輸入驗證、憑證只在後端、設超時與重試上限" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#3B3527;align=left;verticalAlign=top;fillColor=#FBF8F0;strokeColor=#C9BFA6;rounded=1;spacingLeft=10;spacingTop=8;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="72" y="1150" width="1316" height="116" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
