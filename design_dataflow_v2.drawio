        <mxCell id="urgency" value="urgency&#xa;緊急度 0~100&#xa;calc_urgency()" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=12;strokeWidth=1.5;fillColor=#EAE1F7;strokeColor=#6B4BA1;fontColor=#3B2566;" vertex="1" parent="1"><mxGeometry x="301" y="430" width="205" height="72" as="geometry"/></mxCell>
