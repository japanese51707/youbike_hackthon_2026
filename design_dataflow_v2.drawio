        <mxCell id="l4" value="③ 控制平面（有狀態、管決策）&#8212; A 主責　一律走「預覽 &#8594; 確認 &#8594; 執行 &#8594; 驗證」" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=14;fontStyle=1;strokeWidth=2;dashed=0;fillColor=#FFFFFF;strokeColor=#2A6099;fontColor=#123A63;" vertex="1" parent="1"><mxGeometry x="72" y="672" width="880" height="164" as="geometry"/></mxCell>
