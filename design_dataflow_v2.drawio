        <mxCell id="adapter" value="data_source 介面（唯一入口）：get_current_status() / get_history() &#8212; 換源只需新增 adapter + 改 config.data_source.mode（NFR-7）" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=12;strokeWidth=1.5;fillColor=#E9ECEA;strokeColor=#6B7B77;fontColor=#26302E;" vertex="1" parent="1"><mxGeometry x="84" y="306" width="856" height="30" as="geometry"/></mxCell>
        <mxCell id="degrade" value="degradation：來源失效 &#8594; 歷史同時段補值 + 明確標記「過期資料」（NFR-10 降級 / NFR-5 失敗可見）" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;strokeWidth=1.5;fillColor=#FBE0DC;strokeColor=#B3453A;fontColor=#7B2A22;" vertex="1" parent="1"><mxGeometry x="84" y="342" width="856" height="24" as="geometry"/></mxCell>
        <mxCell id="l2" value="② 執行平面（無狀態、可平行）&#8212; B 主責　門口固定、門內自由" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=14;fontStyle=1;strokeWidth=2;dashed=0;fillColor=#FFFFFF;strokeColor=#6B4BA1;fontColor=#3B2566;" vertex="1" parent="1"><mxGeometry x="72" y="396" width="880" height="118" as="geometry"/></mxCell>
