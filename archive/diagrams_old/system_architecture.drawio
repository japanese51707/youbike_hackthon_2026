        </mxCell>
        
        <mxCell id="data-poi" value="站點屬性&#xa;POI/地形/容量&#xa;鄰近站距離" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
