        <mxCell id="ctrl-bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="470" width="1150" height="180" as="geometry" />
        </mxCell>
        
        <mxCell id="ctrl-rule-engine" value="規則引擎&#xa;════════════&#xa;• 觸發條件判斷&#xa;• 優先級排序&#xa;• 資源約束檢查&#xa;• 邊界情境規則&#xa;&#xa;【確定性、可解釋】" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="60" y="490" width="200" height="140" as="geometry" />
        </mxCell>
        
        <mxCell id="ctrl-optimizer" value="最適化調度引擎&#xa;════════════&#xa;• 多站同時派車&#xa;• 路線最短化&#xa;• 空載最小化&#xa;• 疲勞/休息排程&#xa;• 車輛容量限制" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="290" y="490" width="200" height="140" as="geometry" />
        </mxCell>
        
        <mxCell id="ctrl-task-mgr" value="任務管理器&#xa;════════════&#xa;• 任務 ID 唯一綁定&#xa;• 狀態追蹤&#xa;  (pending → in_progress&#xa;   → completed/retryable)&#xa;• 可續跑 Journal&#xa;• 每完成一任務重算" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="520" y="490" width="210" height="140" as="geometry" />
        </mxCell>
        
        <mxCell id="ctrl-ai-boundary" value="AI 邊界情境協作&#xa;════════════&#xa;• 颱風/活動/大雨&#xa;• 規則內自動調參&#xa;• 規則外送人確認&#xa;• 有效時間後恢復" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="760" y="490" width="200" height="140" as="geometry" />
        </mxCell>
        
        <mxCell id="ctrl-kpi" value="KPI 監控&#xa;════════════&#xa;• 空/滿站率&#xa;• 預測準確率&#xa;• 調度響應時間&#xa;• 空載比 (ROI)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="990" y="490" width="180" height="140" as="geometry" />
        </mxCell>
        
        <!-- ========== 人機介面層 ========== -->
