        </mxCell>
        
        <!-- ========== 執行平面（分析模組） ========== -->
        <mxCell id="layer-exec-label" value="執行平面（分析模組 — 無狀態、可平行）" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="30" y="220" width="400" height="30" as="geometry" />
        </mxCell>
        
        <mxCell id="exec-bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#CCCCCC;strokeWidth=2;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="250" width="1150" height="160" as="geometry" />
        </mxCell>
        
        <mxCell id="exec-predict" value="預測模型&#xa;─────────&#xa;基礎方程式&#xa;× 天氣權重&#xa;× 事件權重&#xa;× 壅塞權重" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="270" width="140" height="120" as="geometry" />
        </mxCell>
        
        <mxCell id="exec-tidal" value="潮汐分析&#xa;─────────&#xa;站點間淨流量&#xa;方向辨識&#xa;尖峰/離峰" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="220" y="270" width="140" height="120" as="geometry" />
        </mxCell>
        
        <mxCell id="exec-cluster" value="站群緩衝計算&#xa;─────────&#xa;300~500m 圈&#xa;群內供需彙總&#xa;緩衝餘裕" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="380" y="270" width="140" height="120" as="geometry" />
        </mxCell>
        
        <mxCell id="exec-target" value="動態目標水位&#xa;─────────&#xa;站 × 時段&#xa;理想借/還比例&#xa;非 50/50" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="540" y="270" width="140" height="120" as="geometry" />
        </mxCell>
        
        <mxCell id="exec-anomaly" value="異常偵測&#xa;─────────&#xa;預測偏差&#xa;趨勢惡化&#xa;流量暴增" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="700" y="270" width="140" height="120" as="geometry" />
        </mxCell>
        
        <mxCell id="exec-rebalance" value="調度介入辨識&#xa;─────────&#xa;標記補車痕跡&#xa;還原未干預狀態&#xa;修正訓練資料" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="860" y="270" width="140" height="120" as="geometry" />
        </mxCell>
        
        <mxCell id="exec-adaptive" value="自適應修正&#xa;─────────&#xa;連續偏差偵測&#xa;自動微調權重&#xa;近期資料加權" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1020" y="270" width="140" height="120" as="geometry" />
        </mxCell>
        
        <!-- ========== 控制平面 ========== -->
        <mxCell id="layer-ctrl-label" value="控制平面（狀態管理、決策、授權）" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#666666;" vertex="1" parent="1">
