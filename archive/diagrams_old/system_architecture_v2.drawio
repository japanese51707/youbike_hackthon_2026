    <mxCell id="title" value="&lt;font style=&quot;font-size:22px&quot;&gt;&lt;b&gt;YouBike 智慧調度系統架構 v2&lt;/b&gt;&lt;/font&gt;&amp;nbsp;&amp;nbsp;｜&amp;nbsp;&amp;nbsp;紅粗框＝9/12 Demo 範圍（做深不做廣）　✔＝已完成　★＝本次新增" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;" vertex="1" parent="1">
      <mxGeometry x="40" y="20" width="1300" height="40" as="geometry" />
    </mxCell>
    <mxCell id="lbl-data" value="L0 資料來源層　—　每個來源都要有資料契約：欄位、更新頻率、失效時的 fallback" style="text;html=1;align=left;fontSize=13;fontStyle=1;fontColor=#5B6770;" vertex="1" parent="1">
      <mxGeometry x="40" y="72" width="900" height="26" as="geometry" />
    </mxCell>
    <mxCell id="d1" value="YouBike 即時 API&#xa;(TDX) 1~5 分鐘&#xa;黑客松：歷史重放代替" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
