      <mxGeometry x="430" y="104" width="170" height="62" as="geometry" />
    </mxCell>
    <mxCell id="d4" value="交通資訊&#xa;壅塞・施工・管制" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="620" y="104" width="170" height="62" as="geometry" />
    </mxCell>
    <mxCell id="d5" value="✔ 歷史資料庫&#xa;S3 Parquet + Athena&#xa;1~6 月 · 1,332 萬筆" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#C0392B;strokeWidth=3;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="810" y="104" width="180" height="62" as="geometry" />
    </mxCell>
    <mxCell id="d6" value="站點屬性&#xa;POI・地形・容量&#xa;鄰近站距離" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="1010" y="104" width="160" height="62" as="geometry" />
    </mxCell>
    <mxCell id="lbl-exec" value="執行平面　—　無狀態、可平行、不改真實資料。判準：這件事會不會改到真實世界？不會，才放這裡" style="text;html=1;align=left;fontSize=13;fontStyle=1;fontColor=#5B6770;" vertex="1" parent="1">
      <mxGeometry x="40" y="192" width="900" height="26" as="geometry" />
    </mxCell>
    <mxCell id="exec-bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF7FC;strokeColor=#9673a6;strokeWidth=1.5;dashed=1;" vertex="1" parent="1">
      <mxGeometry x="40" y="222" width="1130" height="300" as="geometry" />
    </mxCell>
    <mxCell id="lbl-offline" value="離線批次（跑在歷史資料上，先算好、可重跑）" style="text;html=1;align=left;fontSize=11;fontStyle=1;fontColor=#9673a6;" vertex="1" parent="1">
      <mxGeometry x="56" y="230" width="420" height="22" as="geometry" />
    </mxCell>
    <mxCell id="e1" value="✔ 調度介入辨識&#xa;─────────&#xa;標記補車／取車痕跡&#xa;改良：每站 ±2~3σ&#xa;取代固定 8 台閾值" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#C0392B;strokeWidth=3;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="56" y="258" width="250" height="100" as="geometry" />
    </mxCell>
    <mxCell id="e2" value="✔ 潮汐分析&#xa;─────────&#xa;站點間淨流量方向&#xa;尖峰／離峰模式" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#C0392B;strokeWidth=3;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="322" y="258" width="250" height="100" as="geometry" />
    </mxCell>
    <mxCell id="e3" value="✔ 動態目標水位&#xa;─────────&#xa;站 × 時段的理想借用率&#xa;非一律 50/50" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#C0392B;strokeWidth=3;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="56" y="370" width="250" height="100" as="geometry" />
    </mxCell>
    <mxCell id="e4" value="★ 模擬重放引擎&#xa;─────────&#xa;用 1~6 月歷史重放&#xa;比較「有／無本系統」的空滿率&#xa;＝成效證明的唯一來源" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#C0392B;strokeWidth=3;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="322" y="370" width="250" height="100" as="geometry" />
    </mxCell>
    <mxCell id="lbl-online" value="線上即時（每 5~30 分鐘重算）" style="text;html=1;align=left;fontSize=11;fontStyle=1;fontColor=#9673a6;" vertex="1" parent="1">
      <mxGeometry x="606" y="230" width="380" height="22" as="geometry" />
    </mxCell>
    <mxCell id="e5" value="預測模型&#xa;─────────&#xa;基線：f(站,星期,時段)&#xa;進階：LightGBM 特徵化&#xa;（天氣/事件當特徵，非外乘權重）&#xa;輸出：點估計＋不確定區間" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#C0392B;strokeWidth=3;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="606" y="258" width="265" height="100" as="geometry" />
    </mxCell>
    <mxCell id="e6" value="站群緩衝計算&#xa;─────────&#xa;300~500m 圈聯合供需&#xa;群內可互相吸收" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="890" y="258" width="265" height="100" as="geometry" />
    </mxCell>
    <mxCell id="e7" value="異常偵測&#xa;─────────&#xa;預測偏差・趨勢惡化&#xa;流量暴增" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="606" y="370" width="265" height="100" as="geometry" />
    </mxCell>
    <mxCell id="e8" value="自適應修正&#xa;─────────&#xa;連續偏差 → 微調該站參數&#xa;（吃 KPI 監控的偏差統計）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="890" y="370" width="265" height="100" as="geometry" />
    </mxCell>
    <mxCell id="lbl-ctrl" value="控制平面　—　有狀態、管決策與授權。判準：會改到真實世界的動作，全部住這裡，而且要過確認閘門" style="text;html=1;align=left;fontSize=13;fontStyle=1;fontColor=#5B6770;" vertex="1" parent="1">
      <mxGeometry x="40" y="548" width="950" height="26" as="geometry" />
