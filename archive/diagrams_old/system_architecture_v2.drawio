    </mxCell>
    <mxCell id="c1" value="規則引擎&#xa;════════&#xa;觸發條件（確定性）&#xa;優先級排序&#xa;邊界情境規則&#xa;吃「區間」不只吃點估計" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#C0392B;strokeWidth=3;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="56" y="596" width="210" height="130" as="geometry" />
    </mxCell>
    <mxCell id="c2" value="最適化調度引擎&#xa;════════&#xa;多站派車・路線&#xa;空載最小化&#xa;疲勞排程・車輛容量" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="286" y="596" width="210" height="130" as="geometry" />
    </mxCell>
    <mxCell id="c3" value="任務管理器&#xa;════════&#xa;唯一 ID・狀態機&#xa;可續跑 Journal&#xa;每完成一任務即重算" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="516" y="596" width="210" height="130" as="geometry" />
    </mxCell>
    <mxCell id="c4" value="AI 邊界情境協作&#xa;════════&#xa;颱風／活動／大雨&#xa;規則內：自動調參&#xa;規則外：送人確認&#xa;有效期滿自動恢復" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="746" y="596" width="200" height="130" as="geometry" />
    </mxCell>
    <mxCell id="c5" value="KPI 監控&#xa;════════&#xa;空滿站率・預測準確率&#xa;響應時間・空載比&#xa;偏差統計 → 餵自適應" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="966" y="596" width="190" height="130" as="geometry" />
    </mxCell>
    <mxCell id="g1" value="① 預覽&#xa;建議清單" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEBD0;strokeColor=#B5892E;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="180" y="762" width="150" height="56" as="geometry" />
    </mxCell>
    <mxCell id="g2" value="② 確認&#xa;【人在迴圈】" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F9E0E0;strokeColor=#C0392B;strokeWidth=2.5;fontSize=10;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="400" y="762" width="150" height="56" as="geometry" />
    </mxCell>
    <mxCell id="g3" value="③ 執行&#xa;派發任務" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEBD0;strokeColor=#B5892E;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="620" y="762" width="150" height="56" as="geometry" />
    </mxCell>
    <mxCell id="g4" value="④ 驗證&#xa;完成回報＋重算" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEBD0;strokeColor=#B5892E;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="840" y="762" width="150" height="56" as="geometry" />
    </mxCell>
    <mxCell id="eg1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#B5892E;strokeWidth=2;" edge="1" parent="1" source="g1" target="g2"><mxGeometry relative="1" as="geometry" /></mxCell>
    <mxCell id="eg2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#B5892E;strokeWidth=2;" edge="1" parent="1" source="g2" target="g3"><mxGeometry relative="1" as="geometry" /></mxCell>
    <mxCell id="eg3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#B5892E;strokeWidth=2;" edge="1" parent="1" source="g3" target="g4"><mxGeometry relative="1" as="geometry" /></mxCell>
    <mxCell id="lbl-ui" value="人機介面層" style="text;html=1;align=left;fontSize=13;fontStyle=1;fontColor=#5B6770;" vertex="1" parent="1">
      <mxGeometry x="40" y="874" width="300" height="26" as="geometry" />
    </mxCell>
    <mxCell id="u1" value="後台儀表板（調度中心）&#xa;─────────&#xa;地圖熱力圖・水位 vs 目標&#xa;異常警報・建議預覽＋確認" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#C0392B;strokeWidth=3;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="40" y="906" width="260" height="96" as="geometry" />
    </mxCell>
    <mxCell id="u2" value="調度員 App&#xa;─────────&#xa;任務・路線・回報&#xa;完成 → 自動接下一任務" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="330" y="906" width="260" height="96" as="geometry" />
    </mxCell>
    <mxCell id="u3" value="推播警報&#xa;─────────&#xa;只在需要行動時推送&#xa;分級：注意／警告／緊急" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="620" y="906" width="260" height="96" as="geometry" />
    </mxCell>
    <mxCell id="u4" value="分析報表&#xa;─────────&#xa;潮汐動畫・Before/After KPI&#xa;模擬重放結果・ROI 試算" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#C0392B;strokeWidth=3;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="910" y="906" width="260" height="96" as="geometry" />
    </mxCell>
    <mxCell id="p1" value="&lt;b&gt;安全&lt;/b&gt;&lt;br&gt;&lt;i&gt;每層各自處理&lt;/i&gt;&lt;br&gt;&lt;br&gt;・角色權限：調度中心／調度員／檢視者，驗在後端&lt;br&gt;&lt;br&gt;・調度指令不可繞過②確認閘門&lt;br&gt;&lt;br&gt;・API 金鑰管理與稽核日誌（誰在何時確認了什麼）&lt;br&gt;&lt;br&gt;・錯誤訊息不外洩內部細節" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF6E5;strokeColor=#B5892E;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=10;fontSize=10.5;" vertex="1" parent="1">
      <mxGeometry x="1210" y="104" width="150" height="418" as="geometry" />
    </mxCell>
    <mxCell id="p2" value="&lt;b&gt;資料生命週期&lt;/b&gt;&lt;br&gt;&lt;br&gt;・路徑：raw → 清洗 → 特徵 → 封存，各階段有主人&lt;br&gt;&lt;br&gt;・污染標記：調度介入時段在訓練資料中要標記或還原&lt;br&gt;&lt;br&gt;・保存期限與封存策略&lt;br&gt;&lt;br&gt;・個資：站點層級資料，無個人軌跡——對評審講清楚這點是加分" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF6E5;strokeColor=#B5892E;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=10;fontSize=10.5;" vertex="1" parent="1">
      <mxGeometry x="1380" y="104" width="150" height="418" as="geometry" />
    </mxCell>
    <mxCell id="p3" value="&lt;b&gt;可維護與交接&lt;/b&gt;&lt;br&gt;&lt;br&gt;・架構文件＋runbook：第二個人第一天能動工&lt;br&gt;&lt;br&gt;・模組介面契約：換掉預測模型不用動規則引擎&lt;br&gt;&lt;br&gt;・任務 Journal 可回放，出事可追&lt;br&gt;&lt;br&gt;・閾值／權重全部外部化成設定檔，不寫死在程式裡" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF6E5;strokeColor=#B5892E;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=10;fontSize=10.5;" vertex="1" parent="1">
      <mxGeometry x="1550" y="104" width="150" height="418" as="geometry" />
    </mxCell>
    <mxCell id="principles" value="&lt;b&gt;⚡ 設計原則&lt;/b&gt;&lt;br&gt;・AI 只估計，規則引擎決策，人在迴圈確認&lt;br&gt;・失敗必須看得到，不靜默&lt;br&gt;・預覽→確認→執行→驗證&lt;br&gt;・預測可失手，判斷不跟著失手&lt;br&gt;・每完成一任務即重算&lt;br&gt;・取捨要刻意：Demo 只做紅框，其餘是 roadmap" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFF0;strokeColor=#CCCCCC;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=10.5;" vertex="1" parent="1">
      <mxGeometry x="1210" y="578" width="490" height="130" as="geometry" />
    </mxCell>
    <mxCell id="lbl-future" value="未來規劃（P2 — 刻意不做，講得出為什麼）" style="text;html=1;align=left;fontSize=13;fontStyle=1;fontColor=#999999;" vertex="1" parent="1">
      <mxGeometry x="1210" y="740" width="480" height="26" as="geometry" />
    </mxCell>
    <mxCell id="f1" value="使用者引導&#xa;App 推播建議站點" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;dashed=1;" vertex="1" parent="1">
      <mxGeometry x="1210" y="772" width="230" height="50" as="geometry" />
    </mxCell>
