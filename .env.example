# 複製成 .env 供本地開發用。絕不 commit 真實憑證（.env 已 gitignore）。

# ── 資料源 ──
# mock（開發用假資料）/ historical（S3 歷史）/ tdx / youbike_official
DATA_SOURCE_MODE=mock

# TDX 公共自行車 API（若用 TDX）
TDX_CLIENT_ID=
TDX_CLIENT_SECRET=

# YouBike 公司官方即時源（若現場改用他們的源）
YOUBIKE_OFFICIAL_URL=

# ── AWS（歷史資料 S3 + Athena）──
AWS_REGION=ap-northeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
S3_BUCKET=youbike-hackathon-2026
ATHENA_DATABASE=youbike_db

# ── 戰情室 Bedrock 顧問（ADR-307）──
# 請把 AWS CLI 憑證填進 secrets/aws-credentials（已被 gitignore）。
# 後端啟動會自動載入，不必再 export。也可改用下面的 AWS_*。
# YOUBIKE_AWS_CREDENTIALS=secrets/aws-credentials
BEDROCK_ENABLED=true
BEDROCK_REGION=ap-northeast-1
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0

# ── 外部 API ──
CWA_WEATHER_API_KEY=
GOOGLE_MAPS_API_KEY=
GOOGLE_ELEVATION_API_KEY=

# ── 前端 → 後端 ──
VITE_API_BASE_URL=
