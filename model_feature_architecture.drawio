        <mxCell id="src-ops" value="營運資料表（level shift）&#10;費率/1.0→2.0/鄰站增退（後補）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#1565c0;fontColor=#111111;fontSize=11;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="940" width="260" height="50" as="geometry" />
