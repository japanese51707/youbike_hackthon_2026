        <mxCell id="g1-box" value="① 環境／靜態因子（ADR-011）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#2e7d32;fontColor=#1b5e20;verticalAlign=top;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="400" y="160" width="360" height="380" as="geometry" />
        </mxCell>
        <mxCell id="f-holiday" value="假日 calendar_holiday.py&#10;放假/國定假日/連假/補班&#10;🟢[靜態](全市)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2e7d32;fontColor=#111111;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="420" y="200" width="320" height="60" as="geometry" />
        </mxCell>
        <mxCell id="f-school" value="學期/學生數 school_calendar.py&#10;寒暑假 + 各級影響人口推估&#10;🟢[靜態](分區)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2e7d32;fontColor=#111111;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="420" y="270" width="320" height="60" as="geometry" />
        </mxCell>
        <mxCell id="f-weather" value="天氣 weather.py&#10;溫濕雨風 + 溫度倒U舒適度&#10;🟡[即時](分區)｜訓練用歷史,現況預測接即時API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2e7d32;fontColor=#111111;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="420" y="340" width="320" height="70" as="geometry" />
        </mxCell>
        <mxCell id="f-terrain" value="地形 terrain.py&#10;高程 → 坡度 → 分類&#10;🟢[靜態](各站)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2e7d32;fontColor=#111111;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="420" y="420" width="320" height="60" as="geometry" />
        </mxCell>

        <mxCell id="g2-box" value="② 時空／POI 因子（ADR-012）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe0b2;strokeColor=#e65100;fontColor=#bf360c;verticalAlign=top;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="400" y="560" width="360" height="380" as="geometry" />
        </mxCell>
        <mxCell id="f-time" value="時間衍生 time_features.py&#10;時段/尖峰/星期/週末/月/季&#10;🟢[靜態](全市)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e65100;fontColor=#111111;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="420" y="600" width="320" height="55" as="geometry" />
        </mxCell>
        <mxCell id="f-poi" value="POI距離 + 區域類型 poi_distance.py&#10;9類POI最近距離,類型自動推導&#10;🟢[靜態](各站)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e65100;fontColor=#111111;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="420" y="665" width="320" height="60" as="geometry" />
        </mxCell>
        <mxCell id="f-daylight" value="日出日落 daylight.py&#10;是否白天/距日落&#10;🟢[靜態](全市)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e65100;fontColor=#111111;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="420" y="735" width="320" height="55" as="geometry" />
        </mxCell>
        <mxCell id="f-event" value="事件 event_impact.py&#10;活動/路跑影響(距離+規模)&#10;🟡[事件](少數站)｜資料後補" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e65100;fontColor=#111111;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="420" y="800" width="320" height="60" as="geometry" />
        </mxCell>
        <mxCell id="f-walert" value="特殊天氣 weather_alert.py&#10;颱風/豪大雨/停班課 異常日標籤&#10;🟡[即時](分區)｜訓練排除+情境預估" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e65100;fontColor=#111111;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="420" y="870" width="320" height="60" as="geometry" />
        </mxCell>

        <mxCell id="g3-box" value="③ 站點時序自身／鄰近／營運（ADR-013）★最強特徵" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffcdd2;strokeColor=#c62828;fontColor=#b71c1c;verticalAlign=top;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="400" y="960" width="360" height="360" as="geometry" />
        </mxCell>
        <mxCell id="f-ts" value="時序自身 station_timeseries.py&#10;lag(前30分/1時/昨日/上週同時段)&#10;變化率/加速度&#10;🔴[即時](各站) ★防洩漏:只用≤t值" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c62828;fontColor=#111111;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="420" y="1000" width="320" height="75" as="geometry" />
        </mxCell>
        <mxCell id="f-stats" value="站點體質(同上模組)&#10;歷史空滿頻率/波動度P90-P10/日均周轉&#10;🟢[日批](各站) 用訓練期前統計" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c62828;fontColor=#111111;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="420" y="1085" width="320" height="65" as="geometry" />
        </mxCell>
        <mxCell id="f-neighbor" value="鄰近站連動 neighbor_stations.py&#10;距離指數衰減 exp(-d/0.3km)+缺車滿站壓力&#10;🔴[即時](各站) ★防洩漏:鄰站用≤t狀態" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c62828;fontColor=#111111;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="420" y="1160" width="320" height="70" as="geometry" />
        </mxCell>
        <mxCell id="f-capacity" value="站點容量(柱數)+故障車柱缺口&#10;缺口=總柱-可借-可還(間接推)&#10;🟢容量[靜態] 🔴缺口[即時](各站)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c62828;fontColor=#111111;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="420" y="1240" width="320" height="65" as="geometry" />
        </mxCell>

        <mxCell id="assemble" value="特徵組裝層 feature builder&#10;&#10;• 對齊 (站點, 時間 t) 合併所有因子&#10;• 時序特徵嚴格用 ≤ t 資料（防資料洩漏，ADR-013）&#10;• 時間切分：1~5月訓練、6月驗證，禁隨機切分（ADR-002）&#10;• 異常日標籤 → 訓練排除/情境預估" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d1c4e9;strokeColor=#4527a0;fontColor=#311b92;fontSize=12;fontStyle=1;verticalAlign=top;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="820" y="480" width="300" height="240" as="geometry" />
        </mxCell>

        <mxCell id="model" value="LightGBM 單一模型（ADR-001/002）&#10;&#10;• 全市共用一個模型&#10;• 站點差異靠條件參數表達&#10;• quantile regression 出區間&#10;• 讓模型自學因子交互作用&#10;  （含天氣×尖峰等非線性）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b2dfdb;strokeColor=#00695c;fontColor=#004d40;fontSize=13;fontStyle=1;verticalAlign=top;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1180" y="480" width="300" height="240" as="geometry" />
        </mxCell>

        <mxCell id="output" value="輸出：PredictionInterval（ADR-004）&#10;&#10;• predicted_available（點估計,僅顯示）&#10;• lower_bound（下界→防空站觸發）&#10;• upper_bound（上界→防滿站觸發）&#10;• horizon：預設30分,可調(對應即時源)&#10;&#10;AI只估計,規則引擎吃區間做決策" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8bbd0;strokeColor=#ad1457;fontColor=#880e4f;fontSize=12;fontStyle=1;verticalAlign=top;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1540" y="480" width="300" height="240" as="geometry" />
        </mxCell>

        <mxCell id="note-core" value="核心約束（ADR-004，不可違反）：AI 只輸出估計值 + 區間，不做決策。所有調度由規則引擎吃「區間下界/上界」觸發，走「預覽→確認→執行→驗證」閘門。" style="text;html=1;fontSize=11;fontColor=#880e4f;align=left;verticalAlign=middle;fillColor=#f8bbd0;strokeColor=#ad1457;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="820" y="760" width="1020" height="50" as="geometry" />
        </mxCell>
        <mxCell id="note-leak" value="★資料洩漏防範（ADR-013）：紅色🔴因子（lag/變化率/加速度/鄰近站狀態/故障缺口）屬「僅事後可知」，預測 t+1 時只能用 ≤ t 的已發生值。所有 lag 特徵時間位移必須 ≤ 0。" style="text;html=1;fontSize=11;fontColor=#b71c1c;align=left;verticalAlign=middle;fillColor=#ffcdd2;strokeColor=#c62828;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="820" y="830" width="1020" height="50" as="geometry" />
        </mxCell>
        <mxCell id="note-cross" value="交叉影響（雨天×尖峰×假日×活動）：目前單因子先行，交叉留待後續 ADR。LightGBM 本身會學部分交互作用。" style="text;html=1;fontSize=11;fontColor=#333333;align=left;verticalAlign=middle;fillColor=#eeeeee;strokeColor=#757575;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="820" y="900" width="1020" height="40" as="geometry" />
        </mxCell>

        <mxCell id="e-g1" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#2e7d32;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="g1-box" target="assemble"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-g2" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#e65100;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="g2-box" target="assemble"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-g3" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#c62828;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="g3-box" target="assemble"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-am" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#4527a0;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="assemble" target="model"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-mo" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#00695c;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="model" target="output"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="e-s3-1" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#1976d2;dashed=1;endArrow=open;" edge="1" parent="1" source="src-s3" target="g3-box"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-holiday-1" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#1976d2;dashed=1;endArrow=open;" edge="1" parent="1" source="src-holiday" target="g1-box"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-osm-2" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#1976d2;dashed=1;endArrow=open;" edge="1" parent="1" source="src-osm" target="g2-box"><mxGeometry relative="1" as="geometry" /></mxCell>
