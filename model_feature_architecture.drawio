          <mxGeometry x="60" y="690" width="260" height="50" as="geometry" />
        </mxCell>
        <mxCell id="src-event" value="事件資料表 events_data.json&#10;（活動/路跑，選項A介面先行）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1565c0;fontColor=#111111;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="760" width="260" height="50" as="geometry" />
        </mxCell>
        <mxCell id="src-suspend" value="停班課日表 typhoon_days.json&#10;（颱風/災害公告，手動維護）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1565c0;fontColor=#111111;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="820" width="260" height="50" as="geometry" />
        </mxCell>
        <mxCell id="src-derived" value="timestamp 衍生 / 站點座標&#10;（無外部資料，直接算）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1565c0;fontColor=#111111;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="880" width="260" height="50" as="geometry" />
