# 複製成 secrets/aws-credentials 後填入真實值。
# secrets/aws-credentials 已被 gitignore，不要 commit。
# 格式與 AWS CLI 的 ~/.aws/credentials 相同，可直接貼 [default] 區塊。

[default]
aws_access_key_id = YOUR_ACCESS_KEY_ID
aws_secret_access_key = YOUR_SECRET_ACCESS_KEY
# 臨時憑證才需要下一行；長期 IAM key 請整行刪掉或留空
aws_session_token =
region = ap-northeast-1

[bedrock]
enabled = true
region = ap-northeast-1
model_id = amazon.nova-lite-v1:0
